# Public Strike market data origin.
STRIKE_API_BASE_URL=https://api.strikefinance.org
# Required for a durable production audit trail.
DATABASE_URL=
# Paper credit issued once per anonymous browser workspace.
PAPER_STARTING_BALANCE_USD=10000
# New paper workspaces one network address may create per hour.
PAPER_WORKSPACES_PER_NETWORK_PER_HOUR=30
# Optional. If set, the scheduled exit sweep can bypass its ten-minute throttle.
CRON_SECRET=
